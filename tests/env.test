# Env file for the test suite (selected by tests/conftest.py via ENV_FILE).
# Placeholders only — the suite must run fully offline with no real
# credentials and no database. Tests that need different values monkeypatch
# them (process env overrides this file) and call get_settings.cache_clear().
API_TOKEN=test-token
ANTHROPIC_API_KEY=test-anthropic-key
FINNHUB_API_KEY=test-finnhub-key
VOYAGE_API_KEY=test-voyage-key
TZ=America/Toronto
PUBLIC_BASE_URL=http://localhost:8000
UNSUBSCRIBE_SECRET=test-unsubscribe-secret
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_PRO_MONTHLY=price_test_monthly
STRIPE_PRICE_PRO_ANNUAL=price_test_annual
