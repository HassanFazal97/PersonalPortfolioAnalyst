# Copy to mobile/.env and fill in. Metro inlines EXPO_PUBLIC_* at build time,
# so restart the dev server after changing anything here.
#
# All three values are public by design — the anon key is a publishable key
# that the web app already ships in every page. No service-role key, no Stripe
# key, and no SnapTrade credential belongs in this file.

# The API to talk to. Point at the local FastAPI app while developing:
#   EXPO_PUBLIC_API_BASE=http://localhost:8000
# A phone on the same network needs the host's LAN IP, not localhost.
EXPO_PUBLIC_API_BASE=https://cirvia.ca

# Same values as SUPABASE_URL / SUPABASE_ANON_KEY in the repo-root .env.
EXPO_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
