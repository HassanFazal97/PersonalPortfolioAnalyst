# Copy to .env and fill in — used by scripts/generate-voiceover.ts.
# ad/ is its own npm project with its own .env, separate from the repo root's.

# ElevenLabs API key (Profile -> API Keys in the ElevenLabs dashboard).
ELEVENLABS_API_KEY=

# Voice ID to narrate with. Audition candidates in the ElevenLabs Voice
# Library against the Scene1 and Scene6 lines (see scripts/lib/voiceover-script.ts)
# before locking one in — favor "narration"/"documentary"/"calm" voices over
# "conversational"/"energetic" ones; this brand is measured, not hype.
ELEVENLABS_VOICE_ID=
